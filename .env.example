POSTGRES_DB=sirisos
POSTGRES_USER=sirisos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://sirisos:change-me@postgres:5432/sirisos
SIRISOS_ENV=development

# Local SirisOS administrator account.
SIRISOS_ADMIN_USERNAME=brad
SIRISOS_ADMIN_PASSWORD=change-this-password

# Generate a long random value before exposing SirisOS beyond a trusted LAN.
SIRISOS_JWT_SECRET=replace-with-a-long-random-secret
SIRISOS_JWT_EXPIRY_HOURS=24

# Homelab warning and critical thresholds.
SIRISOS_CPU_WARNING_PERCENT=80
SIRISOS_CPU_CRITICAL_PERCENT=95
SIRISOS_MEMORY_WARNING_PERCENT=80
SIRISOS_MEMORY_CRITICAL_PERCENT=95
SIRISOS_DISK_WARNING_PERCENT=80
SIRISOS_DISK_CRITICAL_PERCENT=90

# Read-only integration diagnostics.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=replace-with-long-lived-access-token
PLEX_URL=http://192.168.0.100:32400
PLEX_TOKEN=replace-with-plex-token
OLLAMA_URL=http://192.168.0.100:11434

# Health Auto Export MCP server on the local network.
# Keep the iPhone app foregrounded while SirisOS queries it.
HEALTH_AUTO_EXPORT_MCP_URL=http://192.168.0.169:9000/mcp
HEALTH_AUTO_EXPORT_MCP_TOKEN=replace-with-token-from-health-auto-export
HEALTH_AUTO_EXPORT_MCP_TIMEOUT_SECONDS=12

# Address compiled into the Flutter web build.
SIRISOS_API_URL=http://192.168.0.100:8000
