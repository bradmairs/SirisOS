# SirisOS (ADR 106): the hub for the Siris apps plus the engineering module.

# Host port for the SirisOS web app. 6464 is now used by dad-joke-of-the-day.
SIRISOS_PORT=8094
# HTTPS (self-signed) for voice: browsers only allow the microphone on https.
SIRISOS_HTTPS_PORT=8444

# SirisOS sign-in.
SIRISOS_ADMIN_USERNAME=brad
SIRISOS_ADMIN_PASSWORD=change-this-password
# Generate a long random value before exposing SirisOS beyond a trusted LAN.
SIRISOS_JWT_SECRET=replace-with-a-long-random-secret
SIRISOS_JWT_EXPIRY_HOURS=24

# Private engineering standards library. Files are stored under data/standards.
SIRISOS_STANDARDS_MAX_UPLOAD_MB=100
# Local OCR fallback for scanned/image-only standards. Native PDF text is preferred.
SIRISOS_STANDARDS_OCR_ENABLED=true
SIRISOS_STANDARDS_OCR_LANGUAGE=eng
SIRISOS_STANDARDS_OCR_TIMEOUT_SECONDS=300
SIRISOS_STANDARDS_MIN_NATIVE_TEXT_CHARS=40

# Optional SirisHydro answer synthesis on your LAN Ollama. The model must
# already be pulled (`ollama pull <model>`). Leave the model blank to keep
# SirisHydro evidence-only.
OLLAMA_URL=http://192.168.0.100:11434
SIRISOS_OLLAMA_CHAT_MODEL=
SIRISOS_OLLAMA_CHAT_TIMEOUT_SECONDS=30

# Pre-hub Postgres. SirisOS no longer uses it; the container is kept so the
# old data in data/postgres stays intact until you export or drop it.
POSTGRES_DB=sirisos
POSTGRES_USER=sirisos
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Hub connectors (ADR 106). SirisOS calls these apps server-side; nothing here
# reaches the browser. *_URL is how this container reaches the app;
# *_PUBLIC_URL (optional, defaults to *_URL) is what the launch link opens.
# Leave an app's URL blank to show its tile as "not configured".
# ---------------------------------------------------------------------------
# Set false only if an app uses a self-signed certificate.
SIRISOS_HUB_VERIFY_SSL=true

# SirisAI: system assistant, HUD, and the Second Brain (served at /siris/brain).
SIRISAI_URL=http://192.168.0.100:8000
SIRISAI_API_KEY=
SIRISAI_PUBLIC_URL=

# APD Project Management. Use a dedicated VIEWER account.
APD_PM_URL=http://192.168.0.100:8080
APD_PM_PUBLIC_URL=
APD_PM_EMAIL=
APD_PM_PASSWORD=

# Siris Engineering Reviewer. Username/password only if its Basic auth is on.
REVIEWER_URL=http://192.168.0.100:8082
REVIEWER_PUBLIC_URL=
REVIEWER_USERNAME=
REVIEWER_PASSWORD=

# Engineering Archive. Create a read-scope key under the Archive's API keys page.
ARCHIVE_URL=http://192.168.0.100:8091
ARCHIVE_PUBLIC_URL=
ARCHIVE_API_KEY=

# GVW Timesheets (health only; its pages keep their own login).
GVW_URL=http://192.168.0.100:8092
GVW_PUBLIC_URL=

# CMP Capabilities Database.
CMP_URL=http://192.168.0.100:8093
CMP_PUBLIC_URL=
CMP_EMAIL=
CMP_PASSWORD=

# Launch-only tiles. Web URLs or app URL schemes.
HELMARR_URL=
JEFIT_URL=
NEO_SERVER_URL=
