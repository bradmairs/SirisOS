POSTGRES_DB=sirisos
POSTGRES_USER=sirisos
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://sirisos:change-me@postgres:5432/sirisos
SIRISOS_ENV=development

# Local SirisOS administrator account.
SIRISOS_ADMIN_USERNAME=brad
SIRISOS_ADMIN_PASSWORD=change-this-password

# Generate a long random value before exposing SirisOS beyond a trusted LAN.
SIRISOS_JWT_SECRET=replace-with-a-long-random-secret
SIRISOS_JWT_EXPIRY_HOURS=24

# Homelab warning and critical thresholds.
SIRISOS_CPU_WARNING_PERCENT=80
SIRISOS_CPU_CRITICAL_PERCENT=95
SIRISOS_MEMORY_WARNING_PERCENT=80
SIRISOS_MEMORY_CRITICAL_PERCENT=95
SIRISOS_DISK_WARNING_PERCENT=80
SIRISOS_DISK_CRITICAL_PERCENT=90

# Private engineering standards library. Files are stored under data/standards.
SIRISOS_STANDARDS_MAX_UPLOAD_MB=100
# Local OCR fallback for scanned/image-only standards. Native PDF text is preferred.
SIRISOS_STANDARDS_OCR_ENABLED=true
SIRISOS_STANDARDS_OCR_LANGUAGE=eng
SIRISOS_STANDARDS_OCR_TIMEOUT_SECONDS=300
SIRISOS_STANDARDS_MIN_NATIVE_TEXT_CHARS=40

# External integrations. Leave an endpoint blank to keep that connector disabled.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=replace-with-long-lived-access-token
PROMETHEUS_URL=http://192.168.0.100:9090
GRAFANA_URL=http://192.168.0.100:3000
GRAFANA_TOKEN=replace-with-grafana-service-account-token
# Requires Grafana image rendering to be configured; otherwise leave false.
GRAFANA_RENDERING_ENABLED=false
# UniFi Network local API. API keys remain server-side.
UNIFI_URL=https://192.168.0.1
UNIFI_API_KEY=replace-with-unifi-api-key
# Optional; if blank SirisOS uses the first site returned by UniFi.
UNIFI_SITE_ID=
# Many local consoles use a private/self-signed certificate. Enable only when trusted TLS is configured.
UNIFI_VERIFY_SSL=false
# Synology DSM WebAPI. Use a dedicated least-privilege DSM account.
SYNOLOGY_URL=https://192.168.0.50:5001
SYNOLOGY_USERNAME=sirisos
SYNOLOGY_PASSWORD=replace-with-synology-password
SYNOLOGY_VERIFY_SSL=false
# Network UPS Tools (NUT). Leave NUT_HOST blank to disable UPS monitoring.
NUT_HOST=192.168.0.50
NUT_PORT=3493
# Optional; if blank SirisOS uses the first UPS reported by the NUT server.
NUT_UPS_NAME=
NUT_TIMEOUT_SECONDS=4
PLEX_URL=http://192.168.0.100:32400
PLEX_TOKEN=replace-with-plex-token
OLLAMA_URL=http://192.168.0.100:11434

# Health Auto Export MCP server on the local network.
# Keep the iPhone app foregrounded while SirisOS queries it.
HEALTH_AUTO_EXPORT_MCP_URL=http://192.168.0.169:9000/mcp
HEALTH_AUTO_EXPORT_MCP_TOKEN=replace-with-token-from-health-auto-export
HEALTH_AUTO_EXPORT_MCP_TIMEOUT_SECONDS=12

# Production web uses same-origin /api requests through the SirisOS nginx proxy.
# SIRISOS_API_URL is only needed for local Flutter development when the API is on another origin.
