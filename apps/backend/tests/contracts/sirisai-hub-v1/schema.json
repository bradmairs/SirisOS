        },
        "plugged_in": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plugged In"
        },
        "locked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locked"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "low_battery": {
          "default": false,
          "title": "Low Battery",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "summary"
      ],
      "title": "CarSummary",
      "type": "object"
    },
