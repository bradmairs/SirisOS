    "HubInfo": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "1",
          "default": "1",
          "title": "Contract",
          "type": "string"
        },
        "app": {
          "const": "SirisAI",
          "default": "SirisAI",
          "title": "App",
          "type": "string"
        },
        "user": {
          "description": "Who the request is acting as (X-Siris-User, or 'default').",
          "title": "User",
          "type": "string"
        },
        "guest_mode": {
          "description": "While on, personal sections are left out and should be hidden by the client too.",
          "title": "Guest Mode",
          "type": "boolean"
        },
