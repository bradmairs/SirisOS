{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SirisAI hub contract",
  "version": "1",
  "endpoints": {
    "info": {
      "$ref": "#/$defs/HubInfo"
    },
    "brief": {
      "$ref": "#/$defs/Brief"
    },
    "widgets": {
      "$ref": "#/$defs/Widgets"
    },
    "search": {
      "$ref": "#/$defs/SearchResults"
    },
    "attention": {
      "$ref": "#/$defs/AttentionList"
    },
    "attention_act_request": {
      "$ref": "#/$defs/AttentionActRequest"
    },
    "attention_act": {
      "$ref": "#/$defs/AttentionActResult"
    },
    "attention_event": {
      "$ref": "#/$defs/AttentionEvent"
    },
    "protocol_preview": {
      "$ref": "#/$defs/ProtocolPreview"
    },
    "protocol_run_request": {
      "$ref": "#/$defs/ProtocolRunRequest"
    },
    "protocol_run": {
      "$ref": "#/$defs/ProtocolRunResult"
    },
    "camera_look_request": {
      "$ref": "#/$defs/CameraLookRequest"
    },
    "camera_look": {
      "$ref": "#/$defs/CameraLook"
    },
    "llm_complete_request": {
      "$ref": "#/$defs/LLMCompleteRequest"
    },
    "llm_complete": {
      "$ref": "#/$defs/LLMCompleteResult"
    }
  },
  "$defs": {
    "AttentionActRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "title": "AttentionActRequest",
      "type": "object"
    },
    "AttentionActResult": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "$ref": "#/$defs/AttentionItem"
        },
        "result": {
          "default": null,
          "title": "Result"
        }
      },
      "required": [
        "item"
      ],
      "title": "AttentionActResult",
      "type": "object"
    },
    "AttentionAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Pass to POST .../attention/{item}/act.",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "style": {
          "default": "secondary",
          "enum": [
            "primary",
            "secondary",
            "danger"
          ],
          "title": "Style",
          "type": "string"
        },
        "confirm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "If set, ask the user this before acting.",
          "title": "Confirm"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "AttentionAction",
      "type": "object"
    },
    "AttentionCounts": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "default": 0,
          "title": "Open",
          "type": "integer"
        },
        "urgent": {
          "default": 0,
          "title": "Urgent",
          "type": "integer"
        }
      },
      "title": "AttentionCounts",
      "type": "object"
    },
    "AttentionEvent": {
      "additionalProperties": false,
      "description": "One message on GET /siris/hub/v1/attention/stream (an SSE `data:` line).\n`snapshot` comes first with every open item; then `upsert` / `remove`.",
      "properties": {
        "type": {
          "enum": [
            "snapshot",
            "upsert",
            "remove"
          ],
          "title": "Type",
          "type": "string"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttentionItem"
          },
          "title": "Items",
          "type": "array"
        },
        "counts": {
          "$ref": "#/$defs/AttentionCounts"
        }
      },
      "required": [
        "type",
        "counts"
      ],
      "title": "AttentionEvent",
      "type": "object"
    },
    "AttentionItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "key": {
          "description": "Stable identity of the underlying thing (a suggestion, a job, an alert).",
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "alert",
            "confirm",
            "suggestion",
            "review",
            "waiting",
            "notice"
          ],
          "title": "Kind",
          "type": "string"
        },
        "severity": {
          "enum": [
            "urgent",
            "attention",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "body": {
          "default": "",
          "title": "Body",
          "type": "string"
        },
        "source": {
          "description": "What raised it, e.g. 'intruder_check', 'routines', 'habits'.",
          "title": "Source",
          "type": "string"
        },
        "link": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A hint where to look, e.g. 'brain:links' or 'cameras:front_door'.",
          "title": "Link"
        },
        "actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AttentionAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "status": {
          "enum": [
            "open",
            "done",
            "dismissed"
          ],
          "title": "Status",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "kind",
        "severity",
        "title",
        "source",
        "status",
        "created_at",
        "updated_at"
      ],
      "title": "AttentionItem",
      "type": "object"
    },
    "AttentionList": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/AttentionItem"
          },
          "title": "Items",
          "type": "array"
        },
        "counts": {
          "$ref": "#/$defs/AttentionCounts"
        }
      },
      "required": [
        "items",
        "counts"
      ],
      "title": "AttentionList",
      "type": "object"
    },
    "Autonomy": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AutonomyItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "summary"
      ],
      "title": "Autonomy",
      "type": "object"
    },
    "AutonomyItem": {
      "additionalProperties": false,
      "properties": {
        "time": {
          "title": "Time",
          "type": "string"
        },
        "local_time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Time"
        },
        "what": {
          "title": "What",
          "type": "string"
        },
        "why": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "outcome": {
          "default": "done",
          "title": "Outcome",
          "type": "string"
        },
        "verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified"
        }
      },
      "required": [
        "time",
        "what",
        "tool"
      ],
      "title": "AutonomyItem",
      "type": "object"
    },
    "BrainSummary": {
      "additionalProperties": false,
      "properties": {
        "inbox": {
          "default": 0,
          "title": "Inbox",
          "type": "integer"
        },
        "overdue_tasks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OverdueTask"
          },
          "title": "Overdue Tasks",
          "type": "array"
        },
        "deadlines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Deadline"
          },
          "title": "Deadlines",
          "type": "array"
        },
        "auto_linked": {
          "default": 0,
          "title": "Auto Linked",
          "type": "integer"
        },
        "pending_auto_links": {
          "default": 0,
          "title": "Pending Auto Links",
          "type": "integer"
        },
        "unsure_links": {
          "default": 0,
          "title": "Unsure Links",
          "type": "integer"
        },
        "highlights": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Highlights",
          "type": "array"
        },
        "topics": {
          "default": [],
          "description": "Tags growing in the vault lately, most active first.",
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        }
      },
      "title": "BrainSummary",
      "type": "object"
    },
    "Brief": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "guest_mode": {
          "title": "Guest Mode",
          "type": "boolean"
        },
        "hidden": {
          "description": "Sections left out because guest mode is on.",
          "items": {
            "type": "string"
          },
          "title": "Hidden",
          "type": "array"
        },
        "weather": {
          "anyOf": [
            {
              "$ref": "#/$defs/Weather"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calendar": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/CalendarEvent"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calendar"
        },
        "todo": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/TodoItem"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Todo"
        },
        "email": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "health": {
          "anyOf": [
            {
              "$ref": "#/$defs/HealthSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "car": {
          "anyOf": [
            {
              "$ref": "#/$defs/CarSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parcels": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ParcelSummary"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parcels"
        },
        "energy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EnergySummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "brain": {
          "anyOf": [
            {
              "$ref": "#/$defs/BrainSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attention": {
          "$ref": "#/$defs/AttentionCounts"
        },
        "unavailable": {
          "description": "Configured sections that failed this time (each fails alone).",
          "items": {
            "type": "string"
          },
          "title": "Unavailable",
          "type": "array"
        }
      },
      "required": [
        "generated_at",
        "guest_mode",
        "hidden",
        "attention",
        "unavailable"
      ],
      "title": "Brief",
      "type": "object"
    },
    "CalendarEvent": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO date-time, or a bare date for all-day events.",
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "all_day": {
          "default": false,
          "title": "All Day",
          "type": "boolean"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "calendar": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which calendar it's on, e.g. Gmail or an iCloud calendar's name.",
          "title": "Calendar"
        }
      },
      "required": [
        "title"
      ],
      "title": "CalendarEvent",
      "type": "object"
    },
    "CameraLook": {
      "additionalProperties": false,
      "properties": {
        "camera": {
          "title": "Camera",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        }
      },
      "required": [
        "camera",
        "description"
      ],
      "title": "CameraLook",
      "type": "object"
    },
